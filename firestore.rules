rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isApproved() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "approved";
    }

    function isAdmin() {
      return isApproved() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["super_admin", "dept_admin"];
    }

    function isSuperAdmin() {
      return isApproved() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
    }

    function isFaculty() {
      return isApproved() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "faculty";
    }

    // Helper function to check if roll number is unique
    function isRollNumberUnique(rollNumber) {
      return !exists(/databases/$(database)/documents/users/$(rollNumber));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        // Note: Roll number uniqueness is enforced at application level
        // due to Firestore limitations with query-based validation
        request.resource.data.rollNumber is string;
      allow update: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin()) &&
        // Prevent roll number changes after creation
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rollNumber']) ||
         isAdmin());
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isApproved();
      allow create, delete: if isAdmin() || isFaculty();
      allow update: if isAdmin() || 
                       isFaculty() ||
                       // Allow students to mark notifications as read
                       (isApproved() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
    }

    // Resources collection
    match /resources/{resourceId} {
      allow read: if isApproved();
      allow create: if isFaculty() || isAdmin();
      allow update: if (isFaculty() && resource.data.uploadedBy == request.auth.uid) ||
                       isAdmin() ||
                       // Allow students to update likes
                       (isApproved() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])) ||
                       // Allow all approved users to update downloads
                       (isApproved() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']));
      allow delete: if (isFaculty() && resource.data.uploadedBy == request.auth.uid) || isAdmin();
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isAdmin() || 
        isFaculty() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Activity logs
    match /activity_logs/{logId} {
      allow read: if isApproved() && 
        (resource.data.userId == request.auth.uid || 
         isAdmin() || 
         (isSuperAdmin()) ||
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_admin' && 
          resource.data.department == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department));
      allow create: if isApproved();
      allow update, delete: if isAdmin();
    }

    // Chatbot conversations
    match /chatbot_conversations/{conversationId} {
      allow read, write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }
  }
}
